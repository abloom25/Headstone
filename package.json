    "@vitejs/plugin-vue": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "vite": "^6.1.0",
    "wrangler": "^4.0.0"
  }
}
