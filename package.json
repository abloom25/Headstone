  "description": "一座给自己的墓碑 —— 极简黑白的数字墓园",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11.5.3"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/abloom25/Headstone.git"
  },
  "bugs": {
    "url": "https://github.com/abloom25/Headstone/issues"
  },
  "homepage": "https://github.com/abloom25/Headstone#readme",
  "scripts": {
